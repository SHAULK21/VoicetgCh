{
  "name": "telegram-voice-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "deploy": "npm run build && tgcloud push",
    "db:migrate": "tgcloud migrate"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "express": "^4.21.2",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "@tgcloud/cli": "^0.2.0",
    "vite": "8.3.4",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
